# Cloudflare Tunnel token for this app's dedicated tunnel.
# Zero Trust -> Networks -> Tunnels -> Create a tunnel -> Cloudflared -> copy the token.
# Copy this file to .env and fill in the value. .env is gitignored.
CLOUDFLARE_TUNNEL_TOKEN=

# Seals the login session cookie -- any random string of 32+ characters.
# Generate one with: openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=REPLACE_ME
